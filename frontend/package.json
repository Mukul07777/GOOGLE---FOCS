{
  "name": "focs-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:math": "esbuild scripts/math.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/math.test.mjs --log-level=warning && node node_modules/.cache/math.test.mjs",
    "preview": "vite preview",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5",
    "clsx": "^2",
    "katex": "^0.16",
    "lucide-react": "^1.49.0",
    "motion": "^12",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10",
    "react-router-dom": "^7",
    "recharts": "^3",
    "rehype-katex": "^7",
    "remark-gfm": "^4",
    "remark-math": "^6",
    "sonner": "^2",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7"
  }
}
