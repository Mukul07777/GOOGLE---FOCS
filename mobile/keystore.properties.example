# Signing key for a release APK (build_apk.bat release). Copy to keystore.properties, which git ignores.
# Make the key once, and keep the file and its passwords safe: an update must be signed with the same key.
#
#   "%JAVA_HOME%\bin\keytool" -genkeypair -v -keystore focs-release.jks -alias focs -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to mobile/android/app (an absolute path works too; use forward slashes).
storeFile=C:/Users/you/keys/focs-release.jks
storePassword=
keyAlias=focs
keyPassword=
